# --- ClickHouse (raw HTTP requests per traffic source) ---
# Either set CLICKHOUSE_URL (host:port parsed from it) ...
CLICKHOUSE_URL="http://localhost:8123"
# ... or the discrete vars below (used when CLICKHOUSE_URL is unset):
# CLICKHOUSE_HOST="localhost"
# CLICKHOUSE_PORT="8123"
# CLICKHOUSE_SECURE="false"
CLICKHOUSE_USERNAME="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE="shield"

# --- MySQL (traffic-source id <-> name relation) ---
# Either a single DSN ...
MYSQL_URI="mysql://root:root@localhost:3306/local_TWR"
# ... or the discrete vars below (used when MYSQL_URI is unset):
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_USER="root"
# MYSQL_PASSWORD="root"
# MYSQL_DATABASE="local_TWR"
